apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: gitlab-runner
  namespace: flux-system
spec:
  interval: 10m
  targetNamespace: ${namespace}
  driftDetection:
    mode: enabled
  install:
    createNamespace: false
  chart:
    kind: OCIRepository
    spec:
      interval: 1h
      url: oci://registry.gitlab.com/charts/charts.gitlab.io/release/gitlab-runner
      ref:
        tag: ${chart_version}
  values:
    gitlabUrl: https://gitlab.com
    runners:
      secret: gitlab-runner-token
    concurrent: ${concurrent}
    rbac:
      create: true
      rules:
        - apiGroups: [""]
          resources: ["events"]
          verbs: ["list"]
        - apiGroups: [""]
          resources: ["pods"]
          verbs: ["create", "delete", "get", "list", "watch"]
        - apiGroups: [""]
          resources: ["pods/attach", "pods/exec"]
          verbs: ["create", "delete", "get", "patch"]
        - apiGroups: [""]
          resources: ["pods/log"]
          verbs: ["get", "list"]
        - apiGroups: [""]
          resources: ["secrets"]
          verbs: ["create", "delete", "get", "update"]
        - apiGroups: [""]
          resources: ["serviceaccounts"]
          verbs: ["get"]
        - apiGroups: [""]
          resources: ["services"]
          verbs: ["create", "get"]
