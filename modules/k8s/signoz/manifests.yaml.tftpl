apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: signoz
  namespace: flux-system
spec:
  interval: 1h
  url: https://charts.signoz.io
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: signoz
  namespace: flux-system
spec:
  interval: 10m
  targetNamespace: ${namespace}
  driftDetection:
    mode: enabled
  install:
    createNamespace: false
  chart:
    spec:
      chart: signoz
      version: ${chart_version}
      sourceRef:
        kind: HelmRepository
        name: signoz
  values:
    global:
      clusterName: ${cluster_name}

  valuesFrom:
    - kind: Secret
      name: sensitive-signoz-chart-values
      valuesKey: clickhouse_password
      targetPath: clickhouse.password
