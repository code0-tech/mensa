apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: teleport
  namespace: flux-system
spec:
  interval: 1h
  url: https://charts.releases.teleport.dev
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: teleport-cluster
  namespace: flux-system
spec:
  interval: 10m
  targetNamespace: ${namespace}
  driftDetection:
    mode: enabled
  install:
    createNamespace: false
  chart:
    spec:
      chart: teleport-cluster
      version: ${chart_version}
      sourceRef:
        kind: HelmRepository
        name: teleport
  postRenderers:
    - kustomize:
        patches:
          - target:
              kind: Service
              name: teleport-teleport-cluster
            patch: |
              - op: replace
                path: /spec/ports/0/port
                value: ${service_port}
          - target:
              kind: Deployment
              name: teleport-teleport-cluster-proxy
            patch: |
              - op: add
                path: /spec/template/metadata/annotations/checksum~1tls
                value: "${tls_checksum}"
              - op: add
                path: /spec/template/metadata/annotations/checksum~1tls-ca
                value: "${tls_ca_checksum}"
          - target:
              kind: Deployment
              name: teleport-teleport-cluster-auth
            patch: |
              - op: add
                path: /spec/template/metadata/annotations/checksum~1tls-ca
                value: "${tls_ca_checksum}"
  values:
    clusterName: ${cluster_name}
    proxyListenerMode: multiplex
    chartMode: standalone
    authentication:
      type: github
      connectorName: github
      localAuth: false
    highAvailability:
      replicaCount: 1
    operator:
      enabled: true
    tls:
      existingSecretName: ${tls_secret_name}
      existingCASecretName: ${tls_ca_secret_name}
      existingCASecretKeyName: ca.pem
    service:
      type: LoadBalancer
    log:
      level: INFO
      output: stderr
      format: json
    labels:
      cluster: ${teleport_cluster_label}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: teleport-config
  namespace: flux-system
spec:
  interval: 1h
  url: ${config_oci_url}
  ref:
    tag: ${config_oci_tag}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: teleport-config
  namespace: flux-system
spec:
  interval: 10m
  targetNamespace: ${namespace}
  sourceRef:
    kind: OCIRepository
    name: teleport-config
  postBuild:
    substituteFrom:
      - kind: Secret
        name: teleport-config-vars
  prune: true
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: teleport-kube-agent
  namespace: flux-system
spec:
  interval: 10m
  targetNamespace: ${namespace}
  driftDetection:
    mode: enabled
  install:
    createNamespace: false
  chart:
    spec:
      chart: teleport-kube-agent
      version: ${chart_version}
      sourceRef:
        kind: HelmRepository
        name: teleport
  values:
    roles: app
    proxyAddr: tp.code0.tech:443
    joinParams:
      method: kubernetes
      tokenName: administration-cluster
    appResources:
      - labels:
          cluster: administration
    podSecurityPolicy:
      enabled: false
