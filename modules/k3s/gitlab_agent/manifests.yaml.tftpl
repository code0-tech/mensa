apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: gitlab
  namespace: flux-system
spec:
  interval: 1h
  url: https://charts.gitlab.io
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: gitlab-agent
  namespace: flux-system
spec:
  interval: 1h
  targetNamespace: ${namespace}
  install:
    createNamespace: true
  chart:
    spec:
      chart: gitlab-agent
      version: ${agent_version}
      sourceRef:
        kind: HelmRepository
        name: gitlab
  values:
    replicas: 1
    config:
      kasAddress: ${kas_address}
      token: ${agent_token}
