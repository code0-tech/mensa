{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>code0-tech/monoceros//renovate/global.json5",
    ":assignee(Taucher2003)"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchDepNames": [
        "postgres",
        "redis",
        "valkey/valkey"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": [
        "modules/docker/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "additionalBranchPrefix": "{{parentDir}}-"
    },
    {
      "matchDepNames": [
        "ghcr.io/code0-tech/cygnus",
        "ghcr.io/code0-tech/pyxis"
      ],
      "versioning": "regex:^(?<minor>\\d+)$"
    },
    {
      "matchDepNames": [
        "ghcr.io/code0-tech/cygnus"
      ],
      "extends": [
        ":assignee(nicosammito)"
      ]
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "!vendir"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "modules/docker/signoz/pours/deployment/compose.yaml"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "signoz/**",
        "github:SigNoz/**"
      ],
      "groupName": "signoz",
      "additionalBranchPrefix": ""
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "modules/docker/signoz/casting.yaml"
      ],
      "matchStrings": [
        "image: (?<depName>.*?):(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "docker",
      "datasourceTemplate": "docker"
    }
  ]
}
