{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>code0-tech/monoceros//renovate/global.json5",
    ":assignee(Taucher2003)"
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "postgres",
        "redis",
        "valkey/valkey"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": [
        "modules/docker/**",
        "system/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessageSuffix": "[{{parentDir}}]"
    },
    {
      "matchDepNames": [
        "ghcr.io/code0-tech/cygnus",
        "ghcr.io/code0-tech/pyxis",
        "registry.gitlab.com/code0-tech/development/crater"
      ],
      "versioning": "regex:^(?<minor>\\d+)$",
      "maxMajorIncrement": 0
    },
    {
      "matchDepNames": [
        "ghcr.io/code0-tech/cygnus"
      ],
      "extends": [
        ":assignee(nicosammito)"
      ]
    },
    {
      "matchFileNames": [
        ".tool-versions"
      ],
      "matchDepNames": [
        "terraform"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "k3s-io/k3s",
        "https://github.com/k3s-io/k3s"
      ],
      "groupName": "k3s"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/*.tf"
      ],
      "matchStrings": [
        "# renovate: (?:datasource=(?<datasource>[a-zA-Z0-9-._]+)) (?:depName=(?<depName>[^\\s]+))(?: versioning=(?<versioning>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_version\\s+=\\s+\"(?<currentValue>.+?)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "manifests/teleport-config/autoupdate-version.yaml"
      ],
      "matchStrings": [
        "start_version: \\S+\\s*\\n\\s*target_version: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "teleport-cluster",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://charts.releases.teleport.dev",
      "autoReplaceStringTemplate": "start_version: {{{currentValue}}}\n    target_version: {{{newValue}}}"
    }
  ]
}
